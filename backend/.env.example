# 外部服务密钥：本地复制为 .env 后填写。健康检查不依赖这些值，可留空。
BAILIAN_API_KEY=
DEEPSEEK_API_KEY=
AMAP_API_KEY=

# 百炼 ASR（北京地域 OpenAI 兼容接口，与 TTS 不是同一路径）
BAILIAN_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_ASR_MODEL=qwen3-asr-flash

# 百炼 TTS（北京地域 multimodal-generation 接口）
BAILIAN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
BAILIAN_TTS_MODEL=qwen3-tts-flash
BAILIAN_TTS_VOICE=Cherry
BAILIAN_TTS_LANGUAGE=Chinese

# DeepSeek
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# 高德 Web 服务
AMAP_GEO_URL=https://restapi.amap.com/v3/geocode/geo
AMAP_AROUND_URL=https://restapi.amap.com/v3/place/around

# 本地服务
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8003
CORS_ORIGINS=http://localhost:5175
